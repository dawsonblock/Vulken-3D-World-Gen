{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Build",
      "description": "Default configuration with CUDA and GUI support",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
  "VOXELVK_DEMO_WERROR": true,
        "VOXELVK_ENABLE_CUDA": true,
        "VOXELVK_ENABLE_TENSORRT": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "coverage",
      "displayName": "Linux Coverage",
      "description": "Debug with GCOV coverage flags",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_coverage",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": true,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug configuration with all checks enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_debug",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
  "VOXELVK_DEMO_WERROR": true,
        "VOXELVK_ENABLE_CUDA": true,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Optimized release build with LTO",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_release",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true,
        "ENABLE_IMGUI_OVERLAY": false,
        "ENABLE_VALIDATION_LAYERS": false,
        "ENABLE_VK_DEBUG_MARKERS": false,
        "ENABLE_TESTS": true,
  "VOXELVK_DEMO_WERROR": true,
        "VOXELVK_ENABLE_CUDA": true,
        "VOXELVK_ENABLE_TENSORRT": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "headless",
      "displayName": "Headless Training",
      "description": "Server/headless build without Vulkan preview",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_headless",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMGUI_OVERLAY": false,
        "ENABLE_VALIDATION_LAYERS": false,
        "ENABLE_VK_DEBUG_MARKERS": false,
        "ENABLE_TESTS": true,
  "VOXELVK_DEMO_WERROR": true,
        "VOXELVK_ENABLE_CUDA": true,
        "VOXELVK_ENABLE_TENSORRT": true,
        "VOXELVK_HEADLESS_ONLY": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    }
    ,
    {
      "name": "headless-prod",
      "displayName": "Headless Production",
      "description": "Minimal headless build for production images",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_headless",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true,
        "ENABLE_IMGUI_OVERLAY": false,
        "ENABLE_VALIDATION_LAYERS": false,
        "ENABLE_VK_DEBUG_MARKERS": false,
        "ENABLE_TESTS": false,
        "VOXELVK_DEMO_WERROR": false,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VOXELVK_HEADLESS_ONLY": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    }
    ,
    {
      "name": "werror-demos-rl",
      "displayName": "Default + Werror for demos+RL",
      "description": "Default config with -Werror applied to demos and rl_nav_demo via VOXELVK_WERROR_TARGETS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
        "VOXELVK_DEMO_WERROR": true,
        "VOXELVK_WERROR_TARGETS": "smoke_headless;smoke_graphics_headless;vulkan_fullscreen_demo;gui_fullscreen_demo;x11_basic_demo;rl_nav_demo",
        "VOXELVK_ENABLE_CUDA": true,
        "VOXELVK_ENABLE_TENSORRT": true,
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_VERBOSE": true
      }
    }
    ,
    {
      "name": "windows-default",
      "displayName": "Windows Default Build",
      "description": "Default configuration on Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug Build",
      "description": "Debug configuration on Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-debug",
  "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "macos-default",
      "displayName": "macOS Default Build",
      "description": "Default configuration on macOS with GUI extras (MoltenVK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
        "BUILD_EXTRAS": true,
        "VOXELVK_DEMO_WERROR": false,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "VCPKG_HOST_TRIPLET": "x64-osx",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug Build",
      "description": "Debug configuration on macOS with GUI extras (MoltenVK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-debug",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IMGUI_OVERLAY": true,
        "ENABLE_VALIDATION_LAYERS": true,
        "ENABLE_VK_DEBUG_MARKERS": true,
        "ENABLE_TESTS": true,
        "BUILD_EXTRAS": true,
        "VOXELVK_DEMO_WERROR": false,
        "VOXELVK_ENABLE_CUDA": false,
        "VOXELVK_ENABLE_TENSORRT": false,
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "VCPKG_HOST_TRIPLET": "x64-osx",
        "VCPKG_VERBOSE": true
      }
    },
    {
      "name": "ci-linux",
      "inherits": "default",
      "binaryDir": "build/ci-linux",
      "cacheVariables": {
        "VULKEN_ENABLE_WARNINGS_AS_ERRORS": "ON",
        "VULKEN_ENABLE_HARDENING": "ON",
        "VCPKG_FEATURE_FLAGS": "manifest"
      }
    },
    {
      "name": "ci-windows",
      "inherits": "windows-default",
      "binaryDir": "build/ci-windows",
      "cacheVariables": {
        "VULKEN_ENABLE_WARNINGS_AS_ERRORS": "ON",
        "VULKEN_ENABLE_HARDENING": "ON",
        "VCPKG_FEATURE_FLAGS": "manifest"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "werror-demos-rl", "configurePreset": "werror-demos-rl" },
    { "name": "debug",   "configurePreset": "debug"   },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "headless-prod", "configurePreset": "headless-prod" },
    { "name": "windows-default", "configurePreset": "windows-default" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "macos-default", "configurePreset": "macos-default" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "build-ci-linux", "configurePreset": "ci-linux"},
    { "name": "build-ci-windows", "configurePreset": "ci-windows"}
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": {"outputOnFailure": true} },
    { "name": "werror-demos-rl", "configurePreset": "werror-demos-rl", "output": {"outputOnFailure": true} },
    { "name": "coverage", "configurePreset": "coverage", "output": {"outputOnFailure": true} },
    { "name": "debug",   "configurePreset": "debug",   "output": {"outputOnFailure": true} },
    { "name": "release", "configurePreset": "release", "output": {"outputOnFailure": true} },
    { "name": "headless", "configurePreset": "headless", "output": {"outputOnFailure": true} },
    { "name": "windows-default", "configurePreset": "windows-default", "output": {"outputOnFailure": true} },
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true} },
    { "name": "macos-default", "configurePreset": "macos-default", "output": {"outputOnFailure": true} },
    { "name": "macos-debug", "configurePreset": "macos-debug", "output": {"outputOnFailure": true} },
    {"name": "test-ci-linux", "configurePreset": "ci-linux"},
    {"name": "test-ci-windows", "configurePreset": "ci-windows"}
  ]
}