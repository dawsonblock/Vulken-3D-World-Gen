{
  "version": 5,
  "configurePresets": [
    {
      "name": "dev-linux",
      "displayName": "Dev (Linux, vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${env.VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "ENABLE_VALIDATION_LAYERS": "ON"
      }
    },
    {
      "name": "dev-headless",
      "inherits": "dev-linux",
      "displayName": "Dev Headless (Linux, vcpkg)",
      "cacheVariables": {
        "VOXELVK_HEADLESS_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev-linux"
    },
    {
      "name": "dev-headless",
      "configurePreset": "dev-headless"
    }
  ]
}