# VoxelRL_All Training Configuration
# PPO hyperparameters, curriculum, and training settings

training:
  # Algorithm settings
  algorithm: "PPO"          # Reinforcement learning algorithm
  framework: "pytorch"      # Deep learning framework
  
  # Environment settings
  num_envs: 256             # Number of parallel environments
  env_steps_per_update: 2048 # Steps per environment before update
  total_timesteps: 10000000 # Total training timesteps
  
  # Network architecture
  network:
    # Observation encoding
    obs_encoder: "cnn"      # Observation encoder type
    obs_channels: 64        # Initial observation channels
    obs_height: 64          # Observation height
    obs_width: 64           # Observation width
    obs_depth: 64           # Observation depth (for 3D)
    
    # CNN encoder layers
    cnn_layers:
      - filters: 32
        kernel_size: 8
        stride: 4
        activation: "relu"
      - filters: 64
        kernel_size: 4
        stride: 2
        activation: "relu"
      - filters: 64
        kernel_size: 3
        stride: 1
        activation: "relu"
    
    # Recurrent layers
    use_lstm: true          # Use LSTM for memory
    lstm_hidden_size: 512   # LSTM hidden state size
    lstm_num_layers: 1      # Number of LSTM layers
    
    # Action head
    action_dim: 96          # Total action dimensions
    action_branches:        # Discrete action branches
      - size: 6             # Movement actions (forward, back, left, right, up, down)
      - size: 8             # Look actions (8 directions)
      - size: 2             # Use/attack actions
      - size: 10            # Block selection (hotbar)
      - size: 2             # Jump/crouch
    
    # Value head
    value_hidden_size: 512  # Value function hidden size
    
    # Shared layers
    shared_hidden_size: 512 # Shared feature size
    activation: "relu"      # Default activation function
    
  # PPO hyperparameters
  ppo:
    learning_rate: 3.0e-4   # Learning rate
    lr_schedule: "linear"   # Learning rate schedule
    lr_warmup_steps: 10000  # Warmup steps for learning rate
    
    # PPO-specific
    clip_range: 0.2         # PPO clipping parameter
    clip_range_vf: null     # Value function clipping (null = same as clip_range)
    entropy_coef: 0.01      # Entropy coefficient
    value_coef: 0.5         # Value function coefficient
    max_grad_norm: 0.5      # Gradient clipping norm
    
    # Training parameters
    batch_size: 8192        # Training batch size
    minibatch_size: 512     # Minibatch size for updates
    num_epochs: 4           # Number of epochs per update
    
    # GAE (Generalized Advantage Estimation)
    gae_lambda: 0.95        # GAE lambda parameter
    gamma: 0.99             # Discount factor
    
    # KL divergence
    target_kl: 0.015        # Target KL divergence
    kl_coef: 0.2            # KL penalty coefficient
    adaptive_kl: true       # Adaptive KL coefficient
    
  # Reward shaping
  rewards:
    # Basic survival rewards
    survival_reward: 0.001  # Small reward for staying alive
    death_penalty: -1.0     # Penalty for dying
    
    # Task-specific rewards
    place_block_reward: 0.1 # Reward for placing blocks
    break_block_reward: 0.05 # Reward for breaking blocks
    collect_item_reward: 0.2 # Reward for collecting items
    
    # Navigation rewards
    exploration_reward: 0.001 # Reward for exploring new areas
    distance_reward_scale: 0.01 # Scale for distance-based rewards
    height_reward_scale: 0.001  # Scale for height-based rewards
    
    # Goal completion rewards
    goal_completion_reward: 10.0 # Major reward for completing goals
    partial_goal_reward: 1.0     # Partial reward for goal progress
    
    # Social rewards (multi-agent)
    cooperation_reward: 0.5      # Reward for cooperation
    competition_reward: -0.1     # Penalty for competition
    
    # Efficiency rewards
    time_penalty: -0.001         # Small penalty per timestep
    action_penalty: -0.0001      # Very small penalty per action
    
  # Curriculum learning
  curriculum:
    enabled: true           # Enable curriculum learning
    
    # Difficulty progression
    difficulty_metric: "success_rate" # Metric to track for progression
    success_threshold: 0.7  # Success rate threshold to advance
    min_episodes: 1000      # Minimum episodes before advancing
    
    # Stages
    stages:
      - name: "basic_survival"
        description: "Learn basic movement and survival"
        world_size: [32, 32, 32]
        max_episode_steps: 1000
        goals: ["survive_100_steps"]
        
      - name: "block_interaction"
        description: "Learn to place and break blocks"
        world_size: [64, 64, 64]
        max_episode_steps: 2000
        goals: ["place_10_blocks", "break_10_blocks"]
        
      - name: "navigation"
        description: "Learn complex navigation"
        world_size: [128, 128, 128]
        max_episode_steps: 5000
        goals: ["reach_target", "collect_items"]
        
      - name: "construction"
        description: "Learn to build structures"
        world_size: [256, 256, 256]
        max_episode_steps: 10000
        goals: ["build_house", "build_bridge"]
        
      - name: "exploration"
        description: "Learn long-term exploration"
        world_size: [512, 512, 512]
        max_episode_steps: 20000
        goals: ["explore_biomes", "find_ores"]
    
  # Multi-agent settings
  multi_agent:
    enabled: false          # Enable multi-agent training
    num_agents: 4           # Number of agents per environment
    agent_spawn_radius: 16  # Spawn radius for agents
    shared_observations: false # Share observations between agents
    communication_enabled: false # Enable agent communication
    
  # Optimization settings
  optimization:
    # Mixed precision training
    use_amp: true           # Use automatic mixed precision
    amp_dtype: "float16"    # AMP data type (float16 or bfloat16)
    
    # CUDA optimizations
    use_cuda_graphs: true   # Use CUDA graphs for training
    compile_model: true     # Compile model with torch.compile
    
    # Memory optimizations
    gradient_checkpointing: false # Use gradient checkpointing
    dataloader_num_workers: 4     # Number of dataloader workers
    pin_memory: true              # Pin memory for faster GPU transfer
    
    # Distributed training
    distributed: false      # Enable distributed training
    world_size: 1          # Number of processes for distributed training
    rank: 0                # Process rank
    
  # Evaluation settings
  evaluation:
    eval_frequency: 50000   # Evaluate every N timesteps
    eval_episodes: 100      # Number of evaluation episodes
    eval_deterministic: true # Use deterministic policy for evaluation
    eval_render: false      # Render evaluation episodes
    
    # Evaluation metrics
    metrics:
      - "episode_reward"
      - "episode_length"
      - "success_rate"
      - "exploration_coverage"
      - "blocks_placed"
      - "blocks_broken"
      - "items_collected"
      - "deaths"
    
  # Checkpointing
  checkpointing:
    save_frequency: 100000  # Save checkpoint every N timesteps
    max_checkpoints: 5      # Maximum number of checkpoints to keep
    save_replay_buffer: false # Save replay buffer with checkpoint
    
    # Model formats
    save_torchscript: true  # Save as TorchScript
    save_onnx: false        # Save as ONNX
    save_tensorrt: false    # Save as TensorRT (requires TensorRT)
    
  # Logging and monitoring
  logging:
    log_frequency: 1000     # Log metrics every N timesteps
    log_level: "info"       # Logging level
    
    # Logging backends
    tensorboard: true       # Enable TensorBoard logging
    wandb: false           # Enable Weights & Biases logging
    jsonl: true            # Enable JSONL logging
    
    # What to log
    log_gradients: false    # Log gradient statistics
    log_weights: false      # Log weight statistics
    log_activations: false  # Log activation statistics
    log_system_metrics: true # Log system resource usage
    
    # Video recording
    record_video: false     # Record training videos
    video_frequency: 10000  # Record video every N timesteps
    video_length: 100       # Number of steps per video
    
  # Experimentation
  experiment:
    name: "voxel_rl_experiment" # Experiment name
    group: "default"        # Experiment group
    tags: []                # Experiment tags
    notes: ""               # Experiment notes
    
    # Hyperparameter search
    use_optuna: false       # Use Optuna for hyperparameter optimization
    optuna_study_name: null # Optuna study name
    optuna_storage: null    # Optuna storage backend
    
  # Advanced settings
  advanced:
    # Exploration
    exploration_noise: 0.1  # Exploration noise scale
    exploration_decay: 0.995 # Exploration decay rate
    
    # Regularization
    weight_decay: 0.0001    # L2 regularization
    dropout_rate: 0.0       # Dropout rate
    
    # Numerical stability
    epsilon: 1e-8           # Small epsilon for numerical stability
    normalize_advantages: true # Normalize advantages
    normalize_returns: true    # Normalize returns
    
    # Memory management
    max_replay_buffer_size: 1000000 # Maximum replay buffer size
    experience_replay: false        # Use experience replay
    prioritized_replay: false       # Use prioritized experience replay