# VoxelRL_All World Configuration
# Chunk, biome, and world generation parameters

world:
  # Chunk settings
  chunk_size: 32            # Chunk dimension (32x32x32)
  world_height: 256         # Maximum world height
  sea_level: 64             # Sea level for water generation
  
  # World boundaries
  world_radius: 512         # Maximum distance from spawn in chunks
  spawn_radius: 16          # Safe spawn area radius
  
  # Chunk management
  render_distance: 8        # Chunks to render around player
  simulation_distance: 6    # Chunks to simulate
  load_distance: 10         # Chunks to keep loaded
  unload_delay: 30.0        # Seconds before unloading chunks
  
  # Memory management
  max_loaded_chunks: 1000   # Maximum chunks in memory
  chunk_cache_size: 500     # LRU cache size for chunks
  
terrain:
  # Noise generation
  terrain_scale: 0.01       # Primary terrain noise scale
  height_variation: 128     # Maximum height variation
  cave_threshold: 0.4       # Cave generation threshold
  
  # Biome settings
  biome_scale: 0.005        # Biome noise scale
  temperature_scale: 0.003  # Temperature variation scale
  humidity_scale: 0.004     # Humidity variation scale
  
  # Feature generation
  ore_frequency: 0.02       # Ore generation frequency
  structure_frequency: 0.001 # Structure generation frequency
  
  # Terrain layers
  bedrock_height: 5         # Bedrock layer thickness
  dirt_depth: 4             # Average dirt layer depth
  sand_depth: 3             # Beach sand depth
  snow_line: 140            # Snow generation height
  
blocks:
  # Block registry
  air: 0
  stone: 1
  dirt: 2
  grass: 3
  sand: 4
  water: 5
  wood: 6
  leaves: 7
  snow: 8
  bedrock: 9
  coal_ore: 10
  iron_ore: 11
  gold_ore: 12
  diamond_ore: 13
  
biomes:
  # Biome definitions
  plains:
    id: 0
    surface_block: grass
    subsurface_block: dirt
    temperature: 0.8
    humidity: 0.4
    
  desert:
    id: 1
    surface_block: sand
    subsurface_block: sand
    temperature: 2.0
    humidity: 0.0
    
  forest:
    id: 2
    surface_block: grass
    subsurface_block: dirt
    temperature: 0.7
    humidity: 0.8
    tree_density: 0.1
    
  mountains:
    id: 3
    surface_block: stone
    subsurface_block: stone
    temperature: 0.2
    humidity: 0.3
    ore_multiplier: 2.0
    
  ocean:
    id: 4
    surface_block: water
    subsurface_block: sand
    temperature: 0.5
    humidity: 1.0
    depth: 32
    
  tundra:
    id: 5
    surface_block: snow
    subsurface_block: dirt
    temperature: -0.5
    humidity: 0.2
    
generation:
  # World generation settings
  seed: 12345               # World generation seed (0 = random)
  use_caves: true           # Enable cave generation
  use_ores: true            # Enable ore generation
  use_structures: true      # Enable structure generation
  use_biomes: true          # Enable biome generation
  
  # Performance settings
  generation_threads: 4     # Threads for world generation
  async_generation: true    # Generate chunks asynchronously
  pregenerate_radius: 2     # Chunks to pregenerate around spawn
  
  # Optimization
  use_gpu_generation: true  # Use GPU for terrain generation if available
  batch_size: 16            # Chunks to generate in one batch
  
physics:
  # Block physics
  gravity: -9.81            # Gravity acceleration
  terminal_velocity: -53.0  # Maximum fall speed
  air_resistance: 0.98      # Air resistance factor
  
  # Fluid physics
  water_flow_rate: 4        # Water flow speed (ticks)
  lava_flow_rate: 8         # Lava flow speed (ticks)
  fluid_viscosity: 0.8      # Fluid movement resistance
  
  # Collision
  collision_margin: 0.001   # Collision detection margin
  max_step_height: 0.5      # Maximum auto-step height
  
lighting:
  # Light propagation
  max_light_level: 15       # Maximum light value
  light_falloff: 1          # Light decay per block
  sky_light_level: 15       # Sunlight strength
  
  # Light sources
  torch_light_level: 14
  lava_light_level: 15
  glowstone_light_level: 15
  
  # Light updates
  light_update_radius: 16   # Radius for light updates
  async_lighting: true      # Update lighting asynchronously
  
performance:
  # Rendering optimizations
  frustum_culling: true     # Enable frustum culling
  occlusion_culling: true   # Enable occlusion culling
  level_of_detail: true     # Enable LOD for distant chunks
  
  # Memory optimizations
  compress_chunks: true     # Compress chunk data
  use_palettes: true        # Use block palettes for compression
  cache_meshes: true        # Cache generated meshes
  
  # Threading
  main_thread_priority: high
  generation_thread_priority: normal
  lighting_thread_priority: low
  
debug:
  # Debug rendering
  show_chunk_borders: false
  show_biome_colors: false
  show_light_levels: false
  show_generation_stats: false
  
  # Logging
  log_chunk_loading: false
  log_generation_time: false
  log_memory_usage: false
  
  # Profiling
  profile_generation: false
  profile_rendering: false
  profile_physics: false