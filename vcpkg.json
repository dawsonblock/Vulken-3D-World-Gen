{
  "name": "voxelvk",
  "version-string": "2025.09",
  "description": "VoxelVK - High-performance voxel engine with Vulkan rendering, weather systems, and RL training",
  "dependencies": [
    "glfw3",
    "glm",
    "yaml-cpp",
    "shaderc",
  { "name": "imgui", "features": ["glfw-binding", "vulkan-binding"] },
  "vulkan-memory-allocator",
  "vulkan-loader",
    "nlohmann-json",
    "curl",
  "hiredis",
  "redis-plus-plus",
  "stb"
  ],
  "features": {
    "rl": {
      "description": "Reinforcement Learning support",
      "dependencies": []
    },
    "tests": {
      "description": "Testing framework",
      "dependencies": [
        "gtest"
      ]
    }
  }
}