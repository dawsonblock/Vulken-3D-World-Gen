#version 450

// Frustum culling compute shader
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input data
layout(binding = 0) readonly buffer ObjectData {
    vec4 positions[];
} objects;

layout(binding = 1) readonly buffer InstanceData {
    mat4 transforms[];
} instances;

// Output data
layout(binding = 2) buffer VisibleObjects {
    uint visibleIndices[];
} visible;

layout(binding = 3) buffer DrawCount {
    uint drawCount;
} count;

// Frustum planes (6 planes: left, right, bottom, top, near, far)
layout(binding = 4) uniform FrustumUniforms {
    vec4 frustumPlanes[6];
    uint objectCount;
    float boundingRadius;
} frustum;

// Test if a sphere intersects with the frustum
bool sphereInFrustum(vec3 center, float radius) {
    for(int i = 0; i < 6; ++i) {
        float distance = dot(vec4(center, 1.0), frustum.frustumPlanes[i]);
        if(distance < -radius) {
            return false;
        }
    }
    return true;
}

// Test if an AABB intersects with the frustum
bool aabbInFrustum(vec3 min, vec3 max) {
    for(int i = 0; i < 6; ++i) {
        vec3 positive = vec3(
            frustum.frustumPlanes[i].x >= 0.0 ? max.x : min.x,
            frustum.frustumPlanes[i].y >= 0.0 ? max.y : min.y,
            frustum.frustumPlanes[i].z >= 0.0 ? max.z : min.z
        );

        float distance = dot(vec4(positive, 1.0), frustum.frustumPlanes[i]);
        if(distance < 0.0) {
            return false;
        }
    }
    return true;
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if(index >= frustum.objectCount) {
        return;
    }

    // Get object position and transform
    vec3 objectPos = objects.positions[index].xyz;
    mat4 transform = instances.transforms[index];

    // Transform position to world space
    vec3 worldPos = (transform * vec4(objectPos, 1.0)).xyz;

    // Test against frustum
    bool isVisible = sphereInFrustum(worldPos, frustum.boundingRadius);

    if(isVisible) {
        // Use atomic counter to get unique index
        uint visibleIndex = atomicAdd(count.drawCount, 1);
        visible.visibleIndices[visibleIndex] = index;
    }
}
