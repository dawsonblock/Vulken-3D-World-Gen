#version 460
#extension GL_GOOGLE_include_directive : enable
#include "../common/weather_ubo.glsl"
layout(local_size_x=256) in;

struct Particle { vec3 pos; float life; vec3 vel; float pad; };
layout(std430, binding=0) buffer Particles { Particle P[]; };

layout(push_constant) uniform SimPC { vec3 aabbMin; vec3 aabbMax; float dt; } pc;

// Spawns rain (fast vertical) or snow (slow, wind-carried)
void main(){
  uint i = gl_GlobalInvocationID.x;
  Particle p = P[i];

  // decay / respawn
  p.life -= pc.dt;
  if(p.life <= 0.0){
    // spawn above the AABB, random lateral
    uint s = i*1664525u + 1013904223u;
    float rx = float(s%1000)/1000.0; s = s*1664525u+1013904223u;
    float rz = float(s%1000)/1000.0; s = s*1664525u+1013904223u;
    p.pos = vec3(mix(pc.aabbMin.x, pc.aabbMax.x, rx),
                 pc.aabbMax.y + 2.0,
                 mix(pc.aabbMin.z, pc.aabbMax.z, rz));
    p.life = 5.0;
    // initial velocity
    if(uWeather.state==WX_SNOW){
      p.vel = normalize(uWeather.windDir)*0.8 + vec3(0,-0.8,0);
    }else{
      p.vel = normalize(uWeather.windDir)*0.5 + vec3(0,-8.5,0);
    }
  }

  // integrate
  vec3 accel = vec3(0,-9.8,0) * (uWeather.state==WX_SNOW ? 0.15 : 1.0);
  // wind push
  accel += uWeather.windDir * (uWeather.windSpeed * (uWeather.state==WX_SNOW?0.6:0.25));
  p.vel += accel * pc.dt;
  p.pos += p.vel * pc.dt;

  // kill below ground
  if(p.pos.y < pc.aabbMin.y - 2.0){ p.life = 0.0; }

  P[i] = p;
}