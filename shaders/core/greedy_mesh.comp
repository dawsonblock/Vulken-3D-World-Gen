#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input voxel data
layout (set = 0, binding = 0, r8ui) uniform readonly uimage3D uVoxelData;

// Output quad buffer (greedy meshed quads)
struct GreedyQuad {
    vec3 position;    // Bottom-left corner
    vec3 size;        // Width, height, depth of the quad
    vec3 normal;      // Face normal  
    uint material;    // Material ID
};

layout (set = 0, binding = 1) writeonly buffer QuadBuffer {
    GreedyQuad quads[];
} quadBuffer;

// Atomic counter for quad management
layout (set = 0, binding = 2) coherent buffer QuadCounter {
    uint quadCount;
} counter;

// Push constants
layout (push_constant) uniform PushConstants {
    ivec3 chunkSize;
    uint maxQuads;
    vec3 chunkOrigin;
    float voxelSize;
} pc;

// Working memory for slice processing
shared uint slice[64][64];  // 64x64 max slice size
shared bool processed[64][64];

uint getVoxel(ivec3 pos) {
    if (any(lessThan(pos, ivec3(0))) || any(greaterThanEqual(pos, ivec3(pc.chunkSize)))) {
        return 0; // Empty voxel outside bounds
    }
    return imageLoad(uVoxelData, pos).r;
}

void emitQuad(vec3 pos, vec3 size, vec3 normal, uint material) {
    uint quadIndex = atomicAdd(counter.quadCount, 1);
    if (quadIndex >= pc.maxQuads) return;
    
    quadBuffer.quads[quadIndex].position = pc.chunkOrigin + pos * pc.voxelSize;
    quadBuffer.quads[quadIndex].size = size * pc.voxelSize;
    quadBuffer.quads[quadIndex].normal = normal;
    quadBuffer.quads[quadIndex].material = material;
}

void greedyMeshSlice(int axis, int depth) {
    ivec2 localId = ivec2(gl_LocalInvocationID.xy);
    ivec2 sliceSize = (axis == 0) ? pc.chunkSize.yz : (axis == 1) ? pc.chunkSize.xz : pc.chunkSize.xy;
    
    if (any(greaterThanEqual(localId, sliceSize))) return;
    
    // Sample voxel for current position
    ivec3 pos = (axis == 0) ? ivec3(depth, localId.x, localId.y) :
                (axis == 1) ? ivec3(localId.x, depth, localId.y) :
                              ivec3(localId.x, localId.y, depth);
    
    uint voxelType = getVoxel(pos);
    
    // Check if we need to render this face
    ivec3 neighborPos = pos;
    if (axis == 0) neighborPos.x += 1;
    else if (axis == 1) neighborPos.y += 1;  
    else neighborPos.z += 1;
    
    uint neighborType = getVoxel(neighborPos);
    
    // Only render face if voxel is solid and neighbor is empty
    slice[localId.x][localId.y] = (voxelType != 0 && neighborType == 0) ? voxelType : 0;
    processed[localId.x][localId.y] = false;
    
    barrier();
    
    // Greedy meshing algorithm
    if (localId.x == 0 && localId.y == 0) {
        for (int y = 0; y < sliceSize.y; y++) {
            for (int x = 0; x < sliceSize.x; x++) {
                if (processed[x][y] || slice[x][y] == 0) continue;
                
                uint material = slice[x][y];
                
                // Find width of quad
                int width = 1;
                while (x + width < sliceSize.x && 
                       !processed[x + width][y] && 
                       slice[x + width][y] == material) {
                    width++;
                }
                
                // Find height of quad
                int height = 1;
                bool canExtendHeight = true;
                while (y + height < sliceSize.y && canExtendHeight) {
                    for (int i = 0; i < width; i++) {
                        if (processed[x + i][y + height] || slice[x + i][y + height] != material) {
                            canExtendHeight = false;
                            break;
                        }
                    }
                    if (canExtendHeight) height++;
                }
                
                // Mark processed region
                for (int j = 0; j < height; j++) {
                    for (int i = 0; i < width; i++) {
                        processed[x + i][y + j] = true;
                    }
                }
                
                // Emit quad
                vec3 quadPos = (axis == 0) ? vec3(depth, x, y) :
                               (axis == 1) ? vec3(x, depth, y) :
                                             vec3(x, y, depth);
                
                vec3 quadSize = (axis == 0) ? vec3(1, width, height) :
                                (axis == 1) ? vec3(width, 1, height) :
                                              vec3(width, height, 1);
                
                vec3 normal = (axis == 0) ? vec3(1, 0, 0) :
                              (axis == 1) ? vec3(0, 1, 0) :
                                            vec3(0, 0, 1);
                
                emitQuad(quadPos, quadSize, normal, material);
            }
        }
    }
}

void main() {
    ivec3 globalId = ivec3(gl_GlobalInvocationID);
    
    // Process each axis and each depth slice
    int axis = int(globalId.z % 3);  // 0=X, 1=Y, 2=Z axis
    int maxDepth = (axis == 0) ? pc.chunkSize.x : (axis == 1) ? pc.chunkSize.y : pc.chunkSize.z;
    
    for (int depth = 0; depth < maxDepth; depth++) {
        greedyMeshSlice(axis, depth);
        barrier();
    }
}