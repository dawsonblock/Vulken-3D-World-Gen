#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input voxel data
layout (set = 0, binding = 0, r8ui) uniform readonly uimage3D uVoxelData;

// Output vertex buffer
layout (set = 0, binding = 1) writeonly buffer VertexBuffer {
    vec4 vertices[];
} vertexBuffer;

// Output index buffer  
layout (set = 0, binding = 2) writeonly buffer IndexBuffer {
    uint indices[];
} indexBuffer;

// Atomic counters for buffer management
layout (set = 0, binding = 3) coherent buffer Counters {
    uint vertexCount;
    uint indexCount;
} counters;

// Push constants for chunk parameters
layout (push_constant) uniform PushConstants {
    vec3 chunkOrigin;
    uint chunkSize;
    float voxelSize;
} pc;

// Face visibility lookup table
const vec3 faceNormals[6] = {
    vec3( 1, 0, 0),  // +X
    vec3(-1, 0, 0),  // -X
    vec3( 0, 1, 0),  // +Y
    vec3( 0,-1, 0),  // -Y
    vec3( 0, 0, 1),  // +Z
    vec3( 0, 0,-1)   // -Z
};

const ivec3 faceOffsets[6] = {
    ivec3( 1, 0, 0),  // +X
    ivec3(-1, 0, 0),  // -X
    ivec3( 0, 1, 0),  // +Y
    ivec3( 0,-1, 0),  // -Y
    ivec3( 0, 0, 1),  // +Z
    ivec3( 0, 0,-1)   // -Z
};

// Vertex positions for a unit cube face (2 triangles)
const vec3 faceVertices[6][4] = {
    // +X face
    {vec3(1,0,0), vec3(1,1,0), vec3(1,1,1), vec3(1,0,1)},
    // -X face  
    {vec3(0,0,1), vec3(0,1,1), vec3(0,1,0), vec3(0,0,0)},
    // +Y face
    {vec3(0,1,0), vec3(1,1,0), vec3(1,1,1), vec3(0,1,1)},
    // -Y face
    {vec3(0,0,1), vec3(1,0,1), vec3(1,0,0), vec3(0,0,0)},
    // +Z face
    {vec3(0,0,1), vec3(0,1,1), vec3(1,1,1), vec3(1,0,1)},
    // -Z face
    {vec3(1,0,0), vec3(1,1,0), vec3(0,1,0), vec3(0,0,0)}
};

const uint faceIndices[6] = {0, 1, 2, 2, 3, 0};

bool isVoxelSolid(ivec3 pos) {
    if (any(lessThan(pos, ivec3(0))) || any(greaterThanEqual(pos, ivec3(pc.chunkSize)))) {
        return false;
    }
    return imageLoad(uVoxelData, pos).r != 0;
}

void emitQuad(ivec3 voxelPos, int faceIndex) {
    uint baseVertexIndex = atomicAdd(counters.vertexCount, 4);
    uint baseIndexIndex = atomicAdd(counters.indexCount, 6);
    
    // Calculate world position
    vec3 worldPos = pc.chunkOrigin + vec3(voxelPos) * pc.voxelSize;
    vec3 normal = faceNormals[faceIndex];
    
    // Emit 4 vertices for the quad
    for (int i = 0; i < 4; i++) {
        vec3 localPos = faceVertices[faceIndex][i] * pc.voxelSize;
        vec3 vertex = worldPos + localPos;
        
        // Pack position and normal (simple format)
        vertexBuffer.vertices[baseVertexIndex + i] = vec4(vertex, normal.x);
        // Could extend to pack normal.yz, uv coordinates, etc.
    }
    
    // Emit 6 indices for the quad (2 triangles)  
    for (int i = 0; i < 6; i++) {
        indexBuffer.indices[baseIndexIndex + i] = baseVertexIndex + faceIndices[i];
    }
}

void main() {
    ivec3 voxelPos = ivec3(gl_GlobalInvocationID);
    
    // Bounds check
    if (any(greaterThanEqual(voxelPos, ivec3(pc.chunkSize)))) {
        return;
    }
    
    // Skip empty voxels
    if (!isVoxelSolid(voxelPos)) {
        return;
    }
    
    // Check each face and emit if not occluded
    for (int face = 0; face < 6; face++) {
        ivec3 neighborPos = voxelPos + faceOffsets[face];
        
        // Emit face if neighbor is empty or out of bounds
        if (!isVoxelSolid(neighborPos)) {
            emitQuad(voxelPos, face);
        }
    }
}