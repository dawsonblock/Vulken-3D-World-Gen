*.tgz

# Docker

# Configs: keep only example YAML in VCS
/config/*.yaml
!/config/*.example.yaml

# Reports (local/output)
reports/
performance_report.json
redis_validation_report.json

# Env files (never commit real secrets)
*.env
*.env.*

# vcpkg configuration: use vcpkg.json + CMakePresets.json only
.vcpkg-configuration.json
vcpkg-configuration.json

# Local caches
.cache/

# Release bundles
release/

# Build / tool caches
build-*/
.ccls-cache/
.ipynb_checkpoints/

# OS / editor junk
*.swp
.idea/

# Local agents / scratch
.emergent/
*.tmp

# Package mgr / venv
.venv/
*.egg-info/
pip-wheel-metadata/

# Test artifacts
coverage/
*.gcda
*.gcno
*.lcov
