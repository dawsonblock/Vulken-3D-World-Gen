# Build
/build/
/out/
/bin/
/dist/
/obj/
/CMakeFiles/
/CMakeCache.txt
*.vcxproj*
*.sln
/.cache/
/__pycache__/

# Shaders (compiled)
/shaders_vk/**/*.spv
/build/shaders/

# Local configs & logs
/config/local/
/logs/
*.log

# Editor/IDE
.vscode/
.vs/
*.user
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Media and screenshots (not source)
imgui.ini
screenshot.png
*.mp4
*.avi

# Engine/runtime blobs
*.engine
*.plan
*.pt
*.pth
*.torchscript

# Archives (unless specifically tracked)
*.zip
*.7z
*.rar
